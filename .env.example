# Copy to .env.local and add the key locally. Never commit .env.local.
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Alternatively, set AI_PROVIDER=openai and configure:
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# Optional Responses API-compatible base URL (ending in /v1).
# OPENAI_BASE_URL=https://api.openai.com/v1

# Doubao real-time voice (Seeduplex 3.0), server-only API Key from Doubao Voice console.
DOUBAO_REALTIME_API_KEY=
# Optional supported Seeduplex voice; default Vivi 2.0 supports English.
# DOUBAO_REALTIME_VOICE=zh_female_vv_jupiter_bigtts

# Optional: actual acoustic pronunciation assessment (Azure Speech).
# Configure both locally, never in the browser or Git.
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_ENDPOINT=https://YOUR_RESOURCE_NAME.cognitiveservices.azure.com/

# Public deployment (keep unset for the local preview):
# NODE_ENV=production
# HOST=0.0.0.0
# PUBLIC_ORIGIN=https://speaki.cn
# DATABASE_PATH=/app/.data/daylight.sqlite
# TRUST_PROXY=1  # Only use with an explicitly trusted local reverse proxy.
